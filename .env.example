# Public — safe to expose in the browser. Project ID is not a secret.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-10-22
VITE_SITE_URL=http://localhost:5173

# Used by Sanity CLI and the embedded Studio bundle.
# Set these to the same project id and dataset as the VITE_ values.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Server-only. Never prefix with VITE_.
# Editor token used only by `npm run seed`. Do not deploy this value.
SANITY_WRITE_TOKEN=

# Canonical site URL for the contact API and sitemap.
SITE_URL=http://localhost:5173

# Contact delivery. Configure Resend, or SMTP, or both.
# Resend is used when RESEND_API_KEY is set.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# SMTP is used when RESEND_API_KEY is empty and SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
